{
  "name": "timeline",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode emulator --host 127.0.0.1 --port 5174 --strictPort",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "timeline:dev": "vite --mode emulator --host 127.0.0.1 --port 5174 --strictPort",
    "timeline:build": "tsc -b && vite build --mode emulator",
    "timeline:functions": "npm --prefix functions run build",
    "timeline:unit": "npm --prefix functions run build && tsx --test tools/timeline/*.test.ts",
    "timeline:emulators": "node tools/timeline/emulators.mjs start",
    "timeline:test": "node tools/timeline/emulators.mjs test",
    "timeline:seed": "node tools/timeline/seed.mjs",
    "timeline:browser": "node tools/timeline/browser.mjs",
    "timeline:sweep": "node tools/timeline/sweep.mjs",
    "build:emulator": "npm run timeline:build",
    "build:functions": "npm run timeline:functions",
    "test": "npm run timeline:unit",
    "test:emulators": "npm run timeline:test",
    "test:integration": "node tools/timeline/integration.mjs",
    "test:browser": "node tools/timeline/browser.mjs",
    "emulators": "npm run timeline:emulators",
    "seed": "npm run timeline:seed",
    "check": "node tools/timeline/checks.mjs",
    "test:presence": "npm --prefix functions run build && node tools/timeline/presence-integration.mjs",
    "test:session": "npm --prefix functions run build && node tools/timeline/session-integration.mjs",
    "test:session:browser": "node tools/timeline/session-browser.mjs",
    "test:fixtures": "node tools/timeline/fixtures-integration.mjs",
    "test:categories:browser": "node tools/timeline/categories-browser.mjs",
    "test:games:browser": "node tools/timeline/categories-browser.mjs",
    "test:login-memory:browser": "node tools/timeline/login-memory-browser.mjs",
    "test:game-covers": "node tools/timeline/game-covers-integration.mjs",
    "test:interests": "npm run build:functions && node tools/timeline/interests-integration.mjs",
    "test:interests:browser": "node tools/timeline/interests-browser.mjs",
    "test:drafts:integration": "node tools/timeline/drafts-integration.mjs",
    "test:drafts:browser": "node tools/timeline/drafts-browser.mjs"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "firebase": "^10.12.4",
    "pdfjs-dist": "4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.25.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "3.0.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "firebase-tools": "14.22.0",
    "playwright": "1.64.1",
    "tsx": "4.20.6",
    "typescript": "^5.2.2",
    "vite": "^5.3.4",
    "yaml": "2.9.1"
  }
}
