          "layer_buff": {
            "69013003": {
              "title": "",
              "desc": "・<IconMap:Icon_AvatarClass_Anomaly><color=#FFAF2C>[異常]</color>エージェントでの挑戦を推奨。"
            },
            "69013601": {
              "title": "",
              "desc": "・焦天残火が「炎風」状態に入ると、<color=#FFFFFF>「赴く炎」</color>を5重獲得する。<color=#FFFFFF>「赴く炎」</color>1重につき、自身の与ダメージ<color=#FFAF2C>+10%</color>、受ける会心ダメージ<color=#FFAF2C>-25%</color>。焦天残火が<color=#FFFFFF>「赴く炎」</color>を所持している時、<color=#FFAF2C>状態異常</color>になるたびに<color=#FFFFFF>「赴く炎」</color>を1重失い、以降受ける狂咲ダメージ<color=#FFAF2C>+10%</color>。最大3重まで重ね掛け可能、継続時間15秒、重複して発動すると継続時間が更新される。"
            },
            "69013602": {
              "title": "",
              "desc": "・<color=#FFFFFF>「炎風」</color>状態の焦天残火に部位破壊を起こすと、<color=#FFAF2C>1250操作スコア</color>を獲得する。エージェントが<color=#FFAF2C>空中から攻撃を仕掛けてきた焦天残火を撃墜する</color>と<color=#FFAF2C>1500操作スコア</color>を獲得する。焦天残火の<Term:2000003>『封殺スキル』</Term>を<color=#FFAF2C>「完全反撃」</color>すると、<color=#FFAF2C>2000操作スコア</color>を獲得する。最大5000まで獲得可能。"
            }
          },
