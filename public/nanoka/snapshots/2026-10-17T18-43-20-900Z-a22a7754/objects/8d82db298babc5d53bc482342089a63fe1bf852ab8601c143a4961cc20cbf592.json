        "6903802": {
          "name": "悪夢に縛られし者・葉釈淵",
          "stage_num": 2,
          "monster_level": 70,
          "layer_buff": {
            "69013004": {
              "title": "",
              "desc": "・<IconMap:Icon_AvatarClass_Stun><color=#FFAF2C>[撃破]</color>特性のエージェントでの挑戦を推奨。"
            },
            "69012604": {
              "title": "",
              "desc": "・ソベクと「悪夢に縛られし者」が交代で登場するたび、「悪夢に縛られし者」は<color=#FFFFFF>「同調」</color>と<color=#FFFFFF>「捨て身」</color>を1重ずつ獲得する。「同調」と「捨て身」は最大3重まで重ね掛け可能。「同調」1重につき、全属性状態異常蓄積耐性+<color=#FFAF2C>15%</color>、「捨て身」1重につき、「悪夢に縛られし者」のブレイク弱体倍率+<color=#FFAF2C>10%</color>。「悪夢に縛られし者」はブレイク状態に入ると、受ける会心ダメージ+<color=#FFAF2C>50%</color>。"
            },
            "69012603": {
              "title": "",
              "desc": "・エージェントがソベクと「悪夢に縛られし者」を<color=#FFAF2C>弱体状態</color>にすると、<color=#FFAF2C>操作スコアを1500</color>獲得する。エージェントが<color=#FFAF2C>ソベクを倒す</color>と、<color=#FFAF2C>操作スコアを2000</color>獲得する。最大で操作スコアを5000獲得可能。"
            },
