  "semanticCases": [
    {
      "id": "follow-on-view",
      "expect": "no interest count change without explicit follow"
    },
    {
      "id": "guest",
      "expect": "public stories only, no requests/actions, not counted interested"
    },
    {
      "id": "logged-not-followed",
      "expect": "topic heading & follow CTA only in UI"
    },
    {
      "id": "self-vote",
      "expect": "reject if request.submittedBy == voter.uid"
    },
    {
      "id": "edit-lock",
      "expect": "one active EDIT proposal per story under concurrent submit"
    },
    {
      "id": "pending-edit-reset",
      "expect": "new interested snapshot, zero effective votes, new clock"
    },
    {
      "id": "hide-round-retry",
      "expect": "new interest snapshot from fresh HIDE request"
    },
    {
      "id": "hide-approved",
      "expect": "hide public projection, keep internal archive"
    },
    {
      "id": "request-icons",
      "expect": "toggle default OFF, ON ghost/edit warning top-right/hide X top-right"
    },
    {
      "id": "move-relative-anchor",
      "expect": "recompute dependents or mark unresolved without fabrication"
    },
    {
      "id": "no-download",
      "expect": "open documents inline; unsupported format message not forced download"
    }
  ]
