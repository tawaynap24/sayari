      "zone": {
        "6904001": {
          "name": "ギルタブルル",
          "stage_num": 1,
          "monster_level": 70,
          "layer_buff": {
            "69013003": {
              "title": "",
              "desc": "・<IconMap:Icon_AvatarClass_Anomaly><color=#FFAF2C>[異常]</color>エージェントでの挑戦を推奨。"
            },
            "69013903": {
              "title": "69013903_Title",
              "desc": "・エージェントがボスに状態異常を付与するたび、ボスに「残影」を1重付与する。「残影」1重につき、ボスが受ける<color=#2BAD00>状態異常ダメージ+7.5%</color>、受ける「乱流」ダメージが<color=#2BAD00>追加で+5%</color>、継続時間<color=#2BAD00>10秒</color>、「残影」は最大<color=#2BAD00>3重</color>まで重ね掛け可能、継続時間は1重ごとに独立してカウントされる。\n<Term:2000001>「侵蝕障壁」</Term>継続中、ボスに「残影」が付与されると、追加で<color=#FFAF2C>「侵蝕障壁」</color><color=#2BAD00>最大値の20%分</color>が削減されるほか、<color=#2BAD00>15%のブレイク値</color>を蓄積する。<color=#2BAD00>15秒</color>に1回のみ発動可能。<color=#FFAF2C>「侵蝕障壁」</color>が破壊された時、ボスは即座に最大重数の「残影」を獲得する。ボスがブレイク状態に入った時、すべての「残影」は解除され、同じ重数の「裂傷」が付与される。「裂傷」1重につき、ボスの<color=#2BAD00>状態異常蓄積耐性-5%</color>、<color=#2BAD00>ブレイク弱体倍率+10%</color>。ボスのブレイク状態が終了した時、すべての「裂傷」が解除される。"
            },
            "69013904": {
              "title": "69013904_Title",
              "desc": "・ギルタブルルが「侵蝕障壁」を展開した後の連続叩きつけ攻撃をパリィできた場合、そのたびに<color=#FFAF2C>1000操作スコア</color>を獲得する。最後の叩きつけ攻撃で<Term:2000004>『連携パリィ』</Term>を成功させると、追加で<color=#FFAF2C>1000操作スコア</color>を獲得する。<color=#FFAF2C>「侵蝕障壁」の破壊に成功</color>すると、<color=#FFAF2C>1500操作スコア</color>を獲得する。最大で5000操作スコアまで獲得可能。"
            }
          },
