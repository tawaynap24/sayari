            "69013801": {
              "title": "凍剣",
              "desc": "・エージェントが与える<color=#98EFF0>氷属性ダメージ</color>と<color=#F0D12B>物理属性ダメージ</color><color=#2BAD00>+40%</color>。<color=#FFFFFF>「狂咲」</color>の与ダメージは追加で<color=#2BAD00>+20%</color>。\n・エージェントが敵を<color=#FFFFFF>状態異常</color>にすると、その敵の防御力<color=#2BAD00>-15%</color>、<color=#98EFF0>氷属性ダメージ耐性</color><color=#2BAD00>-30%</color>。継続時間10秒、重複して発動すると継続時間が更新される。"
            },
            "69013701": {
              "title": "任命",
              "desc": "・エージェントの透徹ダメージ<color=#2BAD00>+20%</color>。\n・[命破]エージェントが『強化特殊スキル』を発動した時、会心ダメージ<color=#2BAD00>+50%</color>。<color=#FFFFFF>『強化特殊スキル』</color>、<color=#FFFFFF>『終結スキル』</color>が敵に命中した時、敵の<color=#F0D12B>物理属性ダメージ耐性</color>を<color=#2BAD00>30%</color>無視する。継続時間15秒。重複して発動すると継続時間が更新される。"
            },
            "69013201": {
              "title": "砕心",
              "desc": "・エージェントの会心ダメージ<color=#2BAD00>+30%</color>。\n・[強攻]エージェントの攻撃力<color=#2BAD00>+10%</color>、『通常攻撃』が敵に命中した時の与ダメージ<color=#2BAD00>+30%</color>、ターゲットの防御力を<color=#2BAD00>15%</color>無視する。"
            }
          }
