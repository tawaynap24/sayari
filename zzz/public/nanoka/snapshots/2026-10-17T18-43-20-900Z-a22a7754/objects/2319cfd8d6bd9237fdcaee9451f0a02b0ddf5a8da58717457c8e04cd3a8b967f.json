          "selectable_buff": {
            "69012703": {
              "title": "集気",
              "desc": "・エージェントの攻撃力<color=#2BAD00>+16%</color>、敵のブレイク弱体倍率<color=#2BAD00>+30%</color>。\n・エーテルベールの効果を受けているエージェントの攻撃が敵に命中した時、ターゲットの<color=#F0D12B>物理属性ダメージ耐性</color>を<color=#2BAD00>10%</color>、防御力を<color=#2BAD00>15%</color>無視する。"
            },
            "69012301": {
              "title": "幻夢",
              "desc": "・エージェントの異常マスタリー<color=#2BAD00>+40Pt</color>。\n・敵を状態異常にした時、ターゲットの防御力<color=#2BAD00>‐10%</color>、エージェントがターゲットに与える状態異常ダメージ<color=#2BAD00>+20%</color>、継続時間10秒、重複して発動すると継続時間が更新される。"
            },
            "69011202": {
              "title": "奏鳴曲",
              "desc": "・エージェントのデシベル値獲得効率<color=#2BAD00>+20%</color>。\n・<color=#FFFFFF>『終結スキル』</color>と<color=#FFFFFF>『強化特殊スキル』</color>が敵に命中した時、その敵のダメージ耐性を<color=#2BAD00>20%</color>無視する。<color=#FFFFFF>『終結スキル』</color>が敵に命中した時、エージェントの<color=#FFFFFF>『終結スキル』</color>と<color=#FFFFFF>『強化特殊スキル』</color>の与ダメージ<color=#2BAD00>+50%</color>、継続時間30秒、重複して発動すると継続時間が更新される。"
            }
          }
        },
        "6902702": {
          "name": "ミアズマ・フィーンド・名は名なれど",
          "stage_num": 2,
          "monster_level": 70,
          "layer_buff": {
            "69013003": {
              "title": "",
              "desc": "・<IconMap:Icon_AvatarClass_Anomaly><color=#FFAF2C>[異常]</color>エージェントでの挑戦を推奨。"
            },
            "69011602": {
              "title": "",
              "desc": "ミアズマ・フィーンドを<color=#FFAF2C>状態異常</color>にする度、エージェントが与える異常ダメージ+8%、最大6重まで重ね掛け可能。ターゲットが<Term:2000002>「ミアズマシールド」</Term>を発動すると、重数はリセットされる。リセットされたバフ1重につき、<color=#FFAF2C>「ミアズマシールド」</color>への削減効率+2.5%。"
            },
            "69011603": {
              "title": "",
              "desc": "・エージェントがミアズマ・フィーンドの地面攻撃を誘導し、<color=#FFAF2C>一度に5箇所以上のミアズマの沼を起爆させ</color>、かつ<color=#FFAF2C>その攻撃またはミアズマの沼の爆発に被弾しなかった</color>場合、<color=#FFAF2C>1700の操作スコア</color>を獲得する、最大5000まで獲得可能。"
            },
