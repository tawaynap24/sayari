          "a_rank_goal": 14000,
          "b_rank_goal": 6000,
          "selectable_buff": {
            "69011801": {
              "title": "격려",
              "desc": "· 에이전트의 <color=#2EB6FF>전기 속성 피해</color> 및 <color=#F0D12B>물리 피해</color>가 <color=#2BAD00>30% 증가한다</color>.\n· 적을 속성 이상에 빠뜨릴 시 모든 파티원의 공격력이 <color=#2BAD00>8% 증가하고</color>, 데시벨 획득 효율이 <color=#2BAD00>8% 증가한다</color>. 지속 시간: 20초, 최대 중첩: 4스택, 중복 발동 시 지속 시간이 갱신된다."
            },
            "69011202": {
              "title": "소나타",
              "desc": "· 에이전트의 데시벨 획득 효율이 <color=#2BAD00>20% 증가한다</color>.\n· <color=#FFFFFF>[궁극기]</color> 및 <color=#FFFFFF>[강화 특수 스킬]</color>이 적에게 명중 시 해당 적의 피해 저항을 <color=#2BAD00>20%</color> 무시하며, <color=#FFFFFF>[궁극기]</color>가 적에게 명중 후 에이전트의 <color=#FFFFFF>[궁극기]</color> 및 <color=#FFFFFF>[강화 특수 스킬]</color>로 주는 피해가 <color=#2BAD00>50% 증가한다</color>. 지속 시간: 30초. 중복 발동 시 지속 시간이 갱신된다."
            },
            "69011401": {
              "title": "고질병",
              "desc": "· 적을 그로기 상태에 빠뜨린 후, 해당 적의 그로기 약체화 배율이 <color=#2BAD00>25% 증가하고</color>, 그로기 회복 속도가 <color=#2BAD00>10% 감소한다</color>.\n· 에이전트가 콤보 스킬 시전 후, 자신의 공격력이 <color=#2BAD00>20% 증가하고</color>, 치명타 피해가 <color=#2BAD00>30% 증가한다</color>. 지속 시간: 20초"
            }
          }
        },
        "6901802": {
          "name": "미아즈마 프리스트",
          "stage_num": 2,
          "monster_level": 70,
          "layer_buff": {
            "69011302": {
              "title": "",
              "desc": "· 미아즈마 프리스트의 페이즈가 전환될 때마다 자신의 이상 축적 저항이 10% 증가하고, 동시에 자신이 받는 치명타 피해가 30% 증가한다. 최대 중첩: 2스택, <Term:2000002></Term>가 부서지면 모든 스택이 제거된다."
            },
            "69011303": {
              "title": "",
              "desc": "· 에이전트가 <color=#FFAF2C>3초 내에 [패링 지원] 3회 시전에 성공</color> 시 <color=#FFAF2C>조작 점수를 1,000점</color> 획득한다. 조작 점수 최대 획득: 5,000점"
            },
            "69011502": {
