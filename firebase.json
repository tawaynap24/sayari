{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "/game/zenless-zone-zero{,/**}", "destination": "/index.html" },
      { "source": "/timeline", "destination": "/index.html" }
    ],
    "headers": [
      { "source": "/nanoka/current.json", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
      { "source": "/nanoka/discovery.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/nanoka/snapshots/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
      { "source": "/localization/current.json", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
      { "source": "/localization/releases/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
      { "source": "/localization/objects/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
    ]
  }
}
