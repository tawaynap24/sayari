        "6902901": {
          "name": "原初の悪夢・「始まりの主」",
          "stage_num": 1,
          "monster_level": 70,
          "layer_buff": {
            "69013001": {
              "title": "",
              "desc": "・<IconMap:Icon_AvatarClass_Attack><color=#FFAF2C>[強攻]</color>エージェントでの挑戦を推奨。"
            },
            "69012704": {
              "title": "",
              "desc": "・ボスが受ける状態異常ダメージ<color=#2BAD00>-30%</color>。ボスが<Term:2000002></Term>状態から通常状態に、または通常状態から<color=#FFAF2C>「ミアズマシールド」</color>状態に切り替わった時、エージェントがボスに与える会心ダメージ<color=#2BAD00>+20%</color>。最大3重まで重ね掛け可能。ブレイク状態から復帰すると、重ね掛けした効果はリセットされる。"
            },
            "69012705": {
              "title": "",
              "desc": "・<color=#FFAF2C>『ミアズマ浄化』</color>を発動すると、<color=#FFAF2C>1000操作スコア</color>を獲得する。<Term:2000003></Term>期間中、ボスの攻撃への対処に成功するたびに<color=#FFAF2C>500操作スコア</color>を獲得する。ボスの<color=#FFAF2C>『封殺スキル』</color>に<color=#FFAF2C>『完全反撃』</color>すると、<color=#FFAF2C>2000操作スコア</color>を獲得する。<Term:2000003></Term>期間中、<color=#FFAF2C>『カウンター支援』</color>で<color=#FFAF2C>『完全反撃』</color>を発動した場合、その<color=#FFAF2C>『封殺スキル』</color>の残り対処成功スコアを獲得する。最大5000操作スコアまで獲得可能。"
            },
            "69012102": {
              "title": "",
              "desc": ""
            }
          },
